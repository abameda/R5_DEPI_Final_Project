# Raw and processed third-party data must never be uploaded (NFR-08). Only the
# analytical store goes up, from a CLI deploy on a machine that has it; it is
# git-ignored, so Git deploys cannot serve it.
data/*
!data/analytics
data/analytics/*
!data/analytics/jmi.duckdb
*.zip

# Local environments and build output
.env*
.venv/
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
graphify-out/
.claude/
.impeccable/review/

# Not needed by either service
notebooks/
exports/
*.pdf
