{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-api8001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5175,
      "env": {
        "JMI_API": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "stack-5176",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "-c",
        ".venv/Scripts/python.exe -m uvicorn api.main:app --port 8012 & JMI_API=http://127.0.0.1:8012 npm --prefix frontend run dev -- --port 5176 --strictPort"
      ],
      "port": 5176
    }
  ]
}